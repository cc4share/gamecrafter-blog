---
import { getCollection } from 'astro:content';
import { BaseLayout } from '../../theme';
import { site } from '../../site.config';

const posts = await getCollection('blog', ({data})=>!data.draft);
const tags = [...posts.reduce((counts, post)=>{
  for (const tag of post.data.tags) {
    const name=tag.trim();
    if(name) counts.set(name,(counts.get(name)??0)+1);
  }
  return counts;
},new Map<string,number>())].sort(([left],[right])=>left.localeCompare(right,'zh-CN'));
---
<BaseLayout title={`标签 · ${site.name}`} description={`${site.name} 的文章标签。`}>
  <main id="main-content" class="app-layout mt-8 pb-4" data-pagefind-body>
    <nav class="mb-1 font-light" aria-label="面包屑导航">
      <a href="/" class="opacity-80 hover:opacity-100">{site.navigation.home||'首页'}</a>
      <span aria-hidden="true" class="mx-1 opacity-80">&raquo;</span>
      <span class="opacity-75" aria-current="page">标签</span>
    </nav>
    <h1 class="mt-4 text-2xl font-semibold sm:text-3xl">标签</h1>
    <p class="mt-2 mb-6 italic">按标签浏览公开内容。</p>
    {tags.length>0 ? (
      <ul class="flex flex-wrap gap-3">
        {tags.map(([tag,count])=><li><a href={`/tags/${encodeURIComponent(tag)}/`} class="border-border text-accent focus-outline inline-flex items-center gap-2 rounded border px-3 py-2 decoration-dashed underline-offset-4 hover:underline"><span>#{tag}</span><span class="text-muted-foreground text-sm">{count}</span></a></li>)}
      </ul>
    ) : <p class="text-muted-foreground">还没有公开标签。</p>}
  </main>
</BaseLayout>
