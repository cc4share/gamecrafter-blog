---
import { getCollection } from 'astro:content';
import { Archive } from '../../theme';

export async function getStaticPaths() {
  const posts=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
  const tags=[...new Set(posts.flatMap(post=>post.data.tags.map(tag=>tag.trim())).filter(Boolean))];
  return tags.map(tag=>({
    params:{tag},
    props:{tag,posts:posts.filter(post=>post.data.tags.some(value=>value.trim()===tag))},
  }));
}

const {tag,posts}=Astro.props;
const section={
  path:`/tags/${encodeURIComponent(tag)}`,
  navLabel:`标签：${tag}`,
  heading:`#${tag}`,
  description:`共 ${posts.length} 篇公开内容。`,
};
---
<Archive {posts} {section}/>
